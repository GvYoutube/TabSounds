{
  "manifest_version": 3,
  "name": "Tab Sounds",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab_sounds@gvyoutube.net",
      "data_collection_permissions":{
        "required": ["none"]
     }
    }
  },
  "description": "Plays sound effects on tab close, open, and more!",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  }
}
